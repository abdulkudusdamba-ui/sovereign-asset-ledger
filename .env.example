# SAL application configuration
APP_NAME=Sovereign Asset Ledger
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://sal:replace-with-local-password@127.0.0.1:5432/sal
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true

# Redis / background jobs
REDIS_URL=redis://127.0.0.1:6379/0

# Authentication
# Generate a strong random value for SECRET_KEY.
# Never commit the real SECRET_KEY to Git.
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Provenance signing (optional in development, required in production)
# Inject a random value of at least 32 bytes from managed secret storage.
# Never commit a real signing key to Git.
# SAL_PROVENANCE_SIGNING_KEY=
SAL_PROVENANCE_SIGNER_KEY_ID=local-development-key

# Evidence storage
SAL_EVIDENCE_STORAGE_ROOT=./storage/evidence
