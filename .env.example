# SAL application configuration
APP_NAME=Sovereign Asset Ledger
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://sal:replace-with-local-password@127.0.0.1:5432/sal

# Authentication
# Generate a strong random value for SECRET_KEY.
# Never commit the real SECRET_KEY to Git.
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Evidence storage
SAL_EVIDENCE_STORAGE_ROOT=./storage/evidence
